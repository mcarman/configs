[include]
  path = "$XDG_CONFIG_HOME/delta/themes.gitconfig"

[core]
    pager = delta
	excludesfile = /home/carma/.config/git/.gitignore_global

[interactive]
    diffFilter = delta --color-only

[delta]
    features = side-by-side line-numbers decorations catppuccin-mocha
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    hyperlinks = true
    hyperlinks-file-link-format = "http://localhost:8000/open-in-editor?path={path}&line={line}"

[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    file-decoration-style = none
    hunk-header-decoration-style = cyan box ul

[merge]
  conflictStyle = zdiff3

[user]
	name = mcarman
	email = carman.md@live.com

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
